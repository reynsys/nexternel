generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Room {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  devices     Device[]

  @@map("rooms")
}

model Device {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId           String?   @map("room_id") @db.Uuid
  name             String    @db.VarChar(100)
  slug             String    @unique @db.VarChar(100)
  esphomeName      String?   @map("esphome_name") @db.VarChar(100)
  mqttTopicPrefix  String    @map("mqtt_topic_prefix") @db.VarChar(200)
  ipAddress        String?   @map("ip_address")
  macAddress       String?   @map("mac_address") @db.VarChar(17)
  firmwareType     String    @default("esphome") @map("firmware_type") @db.VarChar(50)
  isEnabled        Boolean   @default(true) @map("is_enabled")
  isOnline         Boolean   @default(false) @map("is_online")
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sensors          Sensor[]
  relays           Relay[]

  @@map("devices")
}

model Sensor {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId         String   @map("device_id") @db.Uuid
  name             String   @db.VarChar(100)
  slug             String   @db.VarChar(100)
  sensorType       String   @map("sensor_type") @db.VarChar(50)
  unit             String?  @db.VarChar(20)
  mqttStateTopic   String   @map("mqtt_state_topic") @db.VarChar(300)
  esphomeEntityId  String?  @map("esphome_entity_id") @db.VarChar(100)
  gpioPin          Int?     @map("gpio_pin")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, slug])
  @@map("sensors")
}

model Relay {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId          String   @map("device_id") @db.Uuid
  name              String   @db.VarChar(100)
  slug              String   @db.VarChar(100)
  mqttCommandTopic  String   @map("mqtt_command_topic") @db.VarChar(300)
  mqttStateTopic    String   @map("mqtt_state_topic") @db.VarChar(300)
  esphomeEntityId   String?  @map("esphome_entity_id") @db.VarChar(100)
  gpioPin           Int?     @map("gpio_pin")
  isEnabled         Boolean  @default(true) @map("is_enabled")
  lastState         String?  @map("last_state") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, slug])
  @@map("relays")
}

model Automation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @db.VarChar(150)
  description    String?
  isEnabled      Boolean  @default(true) @map("is_enabled")
  triggerType    String   @map("trigger_type") @db.VarChar(50)
  triggerConfig  Json     @default("{}") @map("trigger_config")
  actionType     String   @map("action_type") @db.VarChar(50)
  actionConfig   Json     @default("{}") @map("action_config")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("automations")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String?  @map("display_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

model DashboardLayout {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String            @default("default") @db.VarChar(100)
  columns   Int               @default(4)
  rows      Int               @default(4)
  isDefault Boolean           @default(true) @map("is_default")
  tabIcon     String   @default("layout-dashboard") @map("tab_icon") @db.VarChar(50)
  showTabLabel Boolean @default(true) @map("show_tab_label")
  widgets   DashboardWidget[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("dashboard_layouts")
}

model DashboardWidget {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layoutId String          @map("layout_id") @db.Uuid
  type     String          @db.VarChar(50)
  title    String?         @db.VarChar(150)
  cell     String          @db.VarChar(10)
  colSpan  Int             @default(1) @map("col_span")
  rowSpan  Int             @default(1) @map("row_span")
  config   Json            @default("{}")
  layout   DashboardLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([layoutId])
  @@map("dashboard_widgets")
}
