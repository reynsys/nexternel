# ESPHome secrets — copy to secrets.yaml and edit before flashing devices.
# secrets.yaml is gitignored; never commit real Wi-Fi or MQTT passwords.
# Package version: see VERSION at repo root.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Ubuntu server LAN IP (same as SERVER_IP in .env)
mqtt_broker: "YOUR_SERVER_IP"

# Must match MQTT_USERNAME / MQTT_PASSWORD in your server .env
mqtt_username: "damnhome"
mqtt_password: "change_me_mqtt_password"

# Optional — ESPHome API encryption key (generate in ESPHome UI if needed)
# api_encryption_key: "base64key..."
