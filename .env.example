# =============================================================================
# DAMN Home - Environment Configuration
# Copy this file to .env and fill in your values before starting the stack.
#
# If a value contains $ # spaces or ! wrap it in double quotes, e.g.:
#   MQTT_PASSWORD="Un1v3r$3"
# =============================================================================

# --- Server (used by Next.js and documentation) ---
# Your Ubuntu machine's LAN address — shown in speed test / network widgets (not the Docker IP).
SERVER_IP=YOUR_SERVER_IP

# --- PostgreSQL ---
POSTGRES_USER=damnhome
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=damnhome
DATABASE_URL=postgresql://damnhome:change_me_postgres_password@postgres:5432/damnhome

# --- InfluxDB 2.x ---
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=change_me_influx_password
INFLUXDB_ORG=damnhome
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=change_me_influx_token_min_32_chars_long
INFLUXDB_URL=http://influxdb:8086

# --- MQTT (Mosquitto) ---
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_USERNAME=damnhome
MQTT_PASSWORD=change_me_mqtt_password
MQTT_TOPIC_PREFIX=damnhome

# --- Next.js Web App ---
NEXTAUTH_SECRET=change_me_random_secret_at_least_32_characters
NEXTAUTH_URL=http://YOUR_SERVER_IP:3000
# COOKIE_SECURE=false
WEB_PORT=3000

# --- Default admin (created on first seed) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# --- Timezone ---
TZ=Europe/London
